{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker serves the web app (static assets) and the API (/api/*) on one hostname,
  // so Cloudflare Access can protect both with one application.
  "name": "verification-console",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "813537406785f2957804689d03560623",
  // Not reachable from the internet until the Access application exists (see docs/DEPLOY.md).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vc-db",
      "database_id": "e92f59d5-96d8-4ada-bb5b-90b6483a1f8c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "vc-sources" }],
  "queues": {
    "producers": [{ "binding": "PIPELINE", "queue": "vc-pipeline" }],
    "consumers": [{ "queue": "vc-pipeline", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 3, "dead_letter_queue": "vc-pipeline-dlq" }]
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "ALLOWED_EMAIL_DOMAIN": "mesquaredagency.com",
    "ACCESS_TEAM_DOMAIN": "mesquaredagency.cloudflareaccess.com"
    // ACCESS_AUD is added once the Access application exists.
    // Secrets (set on the Worker, not here): FILE_URL_SECRET, later ANTHROPIC_API_KEY.
  }
}
